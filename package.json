    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.93.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
